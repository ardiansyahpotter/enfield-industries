---
// Check if user is admin first, before any other operations
if (!isAdmin()) {
  return Astro.redirect('/dashboard');
}

import MainLayout from '../../layouts/MainLayout.astro';
import Card from '../../components/common/Card.astro';
import Button from '../../components/common/Button.astro';
import { isAdmin } from '../../utils/auth.js';

import users from '../../data/users.json';
import projects from '../../data/projects.json';

// Count projects per user
const userProjects = users.map(user => {
  const count = projects.filter(project => project.responsibleUserId === user.id).length;
  return {
    ...user,
    projectCount: count
  };
});
---

<MainLayout title="User Management">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold">All Users ({users.length})</h2>
    
    <Button href="/users/new" variant="primary">
      <span class="mr-1">+</span> New User
    </Button>
  </div>
  
  <Card>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Name
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Email
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Role
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Projects
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          {userProjects.map(user => (
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">{user.name}</div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-500">{user.email}</div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class={`px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${
                  user.role === 'admin' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800'
                }`}>
                  {user.role}
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                {user.projectCount}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <Button href={`/users/${user.id}/edit`} variant="outline" size="sm" className="mr-2">Edit</Button>
                <Button id={`deleteUser-${user.id}`} variant="danger" size="sm">Delete</Button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Card>
</MainLayout>

<script>
  // Delete user simulation
  document.querySelectorAll('[id^="deleteUser-"]').forEach(button => {
    button.addEventListener('click', () => {
      const userId = button.id.split('-')[1];
      if (confirm('This would delete the user in a real application. Continue?')) {
        alert('User deletion would be processed in a production environment.');
      }
    });
  });
</script>