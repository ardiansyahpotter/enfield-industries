---
const { title, variant = 'default' } = Astro.props;

const variants = {
  default: 'border-gray-200 bg-white',
  primary: 'border-primary bg-white',
  success: 'border-status-completed bg-white',
  warning: 'border-status-inProgress bg-white',
  danger: 'border-status-notStarted bg-white'
};

const cardClass = `rounded-lg shadow-md border ${variants[variant]} p-6 transition-all duration-300 hover:shadow-lg animate-fade-in`;
---

<div class={cardClass}>
  {title && <h3 class="text-lg font-semibold mb-4">{title}</h3>}
  <div>
    <slot />
  </div>
</div>